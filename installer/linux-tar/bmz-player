#!/bin/sh
set -eu

# Resolve the launcher (including symlinks), without changing the caller's cwd.
launcher=$(readlink -f -- "$0")
package_dir=${launcher%/*}
export BMZ_RESOURCE_DIR="${BMZ_RESOURCE_DIR:-$package_dir/resources}"
# Bundled client modules must match the private client library. These are only
# search paths; no PipeWire server settings or latency environment are forced.
# Record the caller's values so BMZ restores them for browsers and file managers.
for name in PIPEWIRE_MODULE_DIR SPA_PLUGIN_DIR PIPEWIRE_CONFIG_DIR; do
    if eval "[ -n \"\${$name+set}\" ]"; then
        eval "export BMZ_ORIG_$name=\"\$$name\""
    fi
done
export BMZ_BUNDLED_PIPEWIRE=1
export PIPEWIRE_MODULE_DIR="${PIPEWIRE_MODULE_DIR:-$package_dir/lib/pipewire-0.3}"
export SPA_PLUGIN_DIR="${SPA_PLUGIN_DIR:-$package_dir/lib/spa-0.2}"
export PIPEWIRE_CONFIG_DIR="${PIPEWIRE_CONFIG_DIR:-$package_dir/resources/pipewire}"
if [ -z "${BMZ_DATA_DIR:-}" ]; then
    export BMZ_DATA_DIR="${XDG_DATA_HOME:-${HOME:?HOME or BMZ_DATA_DIR is required}/.local/share}/bmz-player"
    export BMZ_CACHE_DIR="${BMZ_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/bmz-player}"
    export BMZ_LOGS_DIR="${BMZ_LOGS_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/bmz-player/logs}"
fi
exec "$package_dir/bin/bmz-player" "$@"
